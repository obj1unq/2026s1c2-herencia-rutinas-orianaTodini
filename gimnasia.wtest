import gimnasia.*

describe "rutinas" {
		const correrEnLaPlaya = new Running(intensidad=1.2)
		const maratonBA = new MaratonBA(intensidad=1.5) 
		const remarEnElDelta = new Remo() 
		const remarEnCaminoRemeros = new RemoEnCompeticion()
		const calamardo = new PersonaSedentaria(peso=60, tiempoEjercicio=5)
		const bob = new PersonaAtleta(peso=40)
		const clubBarrial = new Club(predios=#{recreo, nautico})
		const recreo = new Predio(rutinas=#{correrEnLaPlaya, maratonBA})
		const nautico = new Predio(rutinas=#{remarEnElDelta, remarEnCaminoRemeros})


test "1.1 consulta running" {
		assert.equals(360,correrEnLaPlaya.caloriasQuemadas(5)) //correrEnLaPlaya deberia gastar 360 calorias al practicarse por 5 minutos
		assert.equals(10200, correrEnLaPlaya.caloriasQuemadas(90)) //correrEnLaPlaya deberia gastar 10200 calorias al practicarse por 90 minutos
	}
test "1.2 consulta maraton" {
		assert.equals(900,	maratonBA.caloriasQuemadas(5))
		assert.equals(25500, maratonBA.caloriasQuemadas(90))
		//maratonBA deberia gastar 900 calorias al practicarse por 5 minutos
		//maratonBA deberia gastar 25500 calorias al practicarse por 90 minutos
	}
test "1.3 consulta remo"{
		assert.equals(520,remarEnElDelta.caloriasQuemadas(5))
		assert.equals(9360, remarEnElDelta.caloriasQuemadas(90))
		//remarEnElDelta deberia gastar 520 calorias al practicarse por 5 minutos
		//remarEnElDelta deberia gastar 9360 calorias al practicarse por 90 minutos
	}
test "1.4 consulta remo competitivo"{ 
		assert.equals(510,remarEnCaminoRemeros.caloriasQuemadas(5))
		assert.equals(12750, remarEnCaminoRemeros.caloriasQuemadas(90))
		//remarEnCaminoRemeros deberia gastar 510 calorias al practicarse por 5 minutos
		//remarEnCaminoRemeros deberia gastar 12750 calorias al practicarse por 90 minutos
	}
// PUNTO 2: Personas
test "2.1 consulta rutina persona sedentaria, correr en la playa"{
	calamardo.aplicarRutina(correrEnLaPlaya) // hacer que calamardo practique correrEnLaPlaya
	assert.equals(59.948,calamardo.peso().truncate(3)) // el peso de calamardo debería ser 59.948 (truncado a 3 decimales)
}
test "2.2 consulta rutina persona sedentaría, correr maratón "{
	calamardo.aplicarRutina(maratonBA) // hacer que calamardo practique maraton
	assert.equals(59.871,calamardo.peso().truncate(3)) // el peso de calamardo debería ser 59.871 (truncado a 3 decimales)
	
}
test "2.3 consulta rutina persona sedendaria, remar en el delta"{
	calamardo.aplicarRutina(remarEnElDelta) // hacer que calamardo practique remarEnElDelta
	assert.equals(59.925,calamardo.peso().truncate(3)) // el peso de calamardo debería ser 59.925 (truncado a 3 decimales)
}
test "2.4 consulta rutina persona sedendaria, remar en camino remeros"{

	calamardo.aplicarRutina(remarEnCaminoRemeros) // hacer que calamardo practique remarEnCaminoRemeros
	assert.equals(59.927,calamardo.peso().truncate(3)) // el peso de calamardo debería ser 59.927 (truncado a 3 decimales)
}
test "2.5 consulta rutina persona sedentaria, correr en la playa con peso 40"{
	calamardo.peso(40) // cambiar el peso de calamardo a 40
	calamardo.aplicarRutina(correrEnLaPlaya) // hacer que calamardo practique correrEnLaPlaya
	assert.equals(40,calamardo.peso().truncate(3)) // el peso de calamardo debería ser 39.948 (truncado a 3 decimales)
}
test "2.6 consulta rutina persona atleta, correr en la playa"{
	bob.aplicarRutina(correrEnLaPlaya) // hacer que bob practique correrEnLaPlaya
	assert.equals(39.725,bob.peso().truncate(3)) // el peso de bob debería ser 39.725 (truncado a 3 decimales)
}
test "2.7 consulta rutina persona atleta, correr maraton"{
	bob.aplicarRutina(maratonBA) // hacer que bob practique maraton
	assert.equals(37.812,bob.peso().truncate(3)) // el peso de bob debería ser 37.812 (truncado a 3 decimales)
}
test "2.8 consulta rutina persona atleta, remar en el delta"{
	bob.aplicarRutina(remarEnElDelta) // hacer que bob practique remarEnElDelta
	assert.equals(40,bob.peso().truncate(3)) // el peso de bob debería ser 40 (no se puede practicar)
}
test "2.9 consulta rutina persona atleta, remar en camino remeros"{
	bob.aplicarRutina(remarEnCaminoRemeros) // hacer que bob practique remarEnCaminoRemeros
	assert.equals(39.406,bob.peso().truncate(3)) // el peso de bob debería ser 39.406 (truncado a 3 decimales)
}
//Punto 3: clubes
test "3.1 el mejor predio" {
		assert.equals(recreo, clubBarrial.elMejorPredioParaPersona(bob)) 		
		assert.equals(recreo, clubBarrial.elMejorPredioParaPersona(calamardo)) 
	}
test "3.2 predios tranquis" {
	   assert.that(clubBarrial.elPredioMasTranquiloParaPersona(bob).isEmpty())
		assert.equals(#{recreo},clubBarrial.elPredioMasTranquiloParaPersona(calamardo))
	}
	
test "3.3 predio con rutinas más exigentes" {
		assert.equals(#{maratonBA,remarEnCaminoRemeros},clubBarrial.elPredioMasExigenteParaPersona(bob))
		assert.equals(#{maratonBA,remarEnElDelta}, clubBarrial.elPredioMasExigenteParaPersona(calamardo))
}
}